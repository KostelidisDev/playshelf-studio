<?xml version="1.0" encoding="utf-8"?>
<!-- Paste this into the SignPath project's artifact configuration. CI uploads the
     Windows executable as a GitHub artifact, which GitHub zips, so the root is a
     zip-file. The product-name check makes SignPath refuse anything else. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" product-name="PlayShelf Studio">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
